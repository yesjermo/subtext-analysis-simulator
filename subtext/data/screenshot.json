{
 "_comment": "Lines that are app chrome, not messages. Matched against the whole line, case-insensitive.",
 "top": 0.09,
 "bottom": 0.9,
 "align_tolerance": 0.06,
 "junk": [
  "\\d{1,2}:\\d{2}\\s*(am|pm)?",
  "(today|yesterday|now|just now)(,? (at )?\\d{1,2}:\\d{2}\\s*(am|pm)?)?",
  "(mon|tue|wed|thu|fri|sat|sun)[a-z]*,?( \\d{1,2}:\\d{2}\\s*(am|pm)?)?",
  "(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\.? \\d{1,2}(,? \\d{4})?(,? (at )?\\d{1,2}:\\d{2}\\s*(am|pm)?)?",
  "\\d{1,2}/\\d{1,2}/\\d{2,4}(,? \\d{1,2}:\\d{2}\\s*(am|pm)?)?",
  "(seen|delivered|read|opened|sent)( (just now|by .*|today.*|yesterday.*|\\d.*))?",
  "active (now|today|yesterday|\\d+\\s*(m|h|d|min|mins|minutes?|hours?|days?) ago)",
  "(typing|is typing)\\.*",
  "(message|send message|send a message|type a message|imessage|text message|add a comment|reply)\\.*",
  "(you )?(liked|loved|reacted to|replied to|replied|mentioned you in) .*",
  "(you )?(liked|loved|reacted|replied)",
  "(tap|double tap|swipe|hold) (to|for) .*",
  "(instagram|tiktok|snapchat|messages|whatsapp|view profile|follow|following|followers|accept|delete|block|report|chat|details)",
  "[<>‹›•·|\\-–—]+",
  "[a-z]{1,2}"
 ],
 "keep_short": [
  "k",
  "kk",
  "ok",
  "ya",
  "u",
  "no",
  "ye",
  "yo",
  "hi",
  "omg",
  "lol",
  "ty",
  "np",
  "gm",
  "gn"
 ],
 "strip_prefix": "^[O0o©@®°•●]\\s+(?=\\S)",
 "_layouts": "Two layouts besides plain bubbles. WhatsApp-style: a time (and ticks) inside each bubble, stripped from the words when two or more lines end with one; a time on its own line still says which side its bubble is on. Name-label style (Snapchat, Discord): no bubbles, every line on the left, a name above each run of messages.",
 "time_tail": "\\s+\\d{1,2}[:.]\\d{2}\\s*(?:[ap]\\.?\\s?[mvy]\\.?)?(?:\\s*[v✓✔]){0,2}\\s*$",
 "time_only": "^\\d{1,2}[:.]\\d{2}\\s*(?:[ap]\\.?\\s?[mvy]\\.?)?(?:\\s*[v✓✔]){0,2}$",
 "header_time": "^(\\S+(?: \\S+){0,2})\\s+(?:today|yesterday|\\d{1,2}[/.]\\d{1,2}[/.]\\d{2,4})\\b",
 "time_beside": "^(?:today|yesterday|\\d{1,2}[/.]\\d{1,2}[/.]\\d{2,4}|\\d{1,2}[:.]\\d{2})",
 "label_caps": "^[A-Z][A-Z0-9._ -]{0,23}$",
 "me_labels": [
  "me",
  "you",
  "myself"
 ],
 "username": "^[\\w.\\-]{2,24}(?: [\\w.\\-]{1,24})?$"
}
